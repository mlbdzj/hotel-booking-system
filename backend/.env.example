# 复制为 backend/.env 后按需修改（.env 不会被提交到仓库）

# 数据库连接
DATABASE_URL=mysql+pymysql://root:your_password@127.0.0.1:3306/hotel_booking

# 鉴权
SECRET_KEY=please-change-me-to-a-random-string
TOKEN_EXPIRE_MINUTES=10080

# 首次启动自动建表并写入演示数据
INIT_DB_ON_STARTUP=true
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=123456
DEFAULT_USER_USERNAME=student
DEFAULT_USER_PASSWORD=123456

# 智能助手（不配置密钥时会自动使用本地知识库引擎）
# auto：有密钥走大模型，否则本地知识库；llm：强制大模型；local：只用本地知识库
AGENT_PROVIDER=auto
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# LLM_API_KEY 留空时会自动读取环境变量 DEEPSEEK_API_KEY 或 OPENAI_API_KEY
